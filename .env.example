# Copy to .env and replace the demo secret before any shared deployment.
AGENTFLOW_ENVIRONMENT=local
AGENTFLOW_DATABASE_URL=sqlite:///./data/agentflow.db
AGENTFLOW_JWT_SECRET=replace-this-with-a-long-random-string
AGENTFLOW_PROVIDER=local
AGENTFLOW_OPENAI_API_KEY=
AGENTFLOW_OPENAI_MODEL=gpt-4o-mini
AGENTFLOW_ANTHROPIC_API_KEY=
AGENTFLOW_ANTHROPIC_MODEL=claude-3-5-haiku-latest
AGENTFLOW_VECTOR_BACKEND=local
AGENTFLOW_VECTOR_PATH=./data/vectors
AGENTFLOW_REDIS_URL=
AGENTFLOW_CACHE_TTL_SECONDS=300
AGENTFLOW_LOG_LEVEL=INFO
AGENTFLOW_MONTHLY_BUDGET_USD=25
AGENTFLOW_ALERT_WEBHOOK=
